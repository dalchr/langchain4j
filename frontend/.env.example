# Backend proxy target for Vite dev server
# Defaults to http://localhost:8080 if not set.
# Change this when running the Vite dev server on a remote host
# so that the proxy forward points to the correct Ktor backend.
#
# Example for remote development:
#   VITE_BACKEND_HOST=http://finndet-host02:8080
#
VITE_BACKEND_HOST=http://localhost:8080
